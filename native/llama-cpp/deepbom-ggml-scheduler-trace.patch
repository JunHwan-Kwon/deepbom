+static std::atomic<uint64_t> deepbom_trace_sequence{0};
+static std::mutex deepbom_trace_mutex;
+
+static void deepbom_trace_hex(FILE * fp, const char * text) {
+    static const char hex[] = "0123456789abcdef";
+    const unsigned char * p = (const unsigned char *) (text ? text : "");
+    for (; *p != 0; ++p) {
+        fputc(hex[*p >> 4], fp);
+        fputc(hex[*p & 0x0f], fp);
+    }
+}
+
+static void deepbom_trace_tensor_ref(FILE * fp, const struct ggml_cgraph * graph, const struct ggml_tensor * tensor) {
+    if (tensor == NULL) {
+        fputc('-', fp);
+        return;
+    }
+    for (int i = 0; i < graph->n_nodes; ++i) {
+        if (graph->nodes[i] == tensor) {
+            fprintf(fp, "N%d", i);
+            return;
+        }
+    }
+    for (int i = 0; i < graph->n_leafs; ++i) {
+        if (graph->leafs[i] == tensor) {
+            fprintf(fp, "L%d", i);
+            return;
+        }
+    }
+    fputs("X", fp);
+    deepbom_trace_hex(fp, tensor->name);
+}
+
+static int deepbom_trace_split_id(ggml_backend_sched_t sched, int original_node_index) {
+    for (int i = 0; i < sched->n_splits; ++i) {
+        if (original_node_index >= sched->splits[i].i_start && original_node_index < sched->splits[i].i_end) {
+            return i;
+        }
+    }
+    return -1;
+}
+
+static void deepbom_trace_tensor(
+        ggml_backend_sched_t sched,
+        FILE * fp,
+        const char * event,
+        uint64_t sequence,
+        int index,
+        int split_id,
+        int backend_id,
+        const struct ggml_cgraph * graph,
+        const struct ggml_tensor * tensor) {
+    fprintf(fp, "DEEPBOM_GGML_TRACE_V1\t%s\t%llu\t%d\t%d\t", event, (unsigned long long) sequence, index, split_id);
+    if (backend_id >= 0) {
+        GGML_ASSERT(backend_id < sched->n_backends);
+        deepbom_trace_hex(fp, ggml_backend_name(sched->backends[backend_id]));
+    } else {
+        fputc('-', fp);
+    }
+    fputc('\t', fp);
+    deepbom_trace_hex(fp, ggml_op_desc(tensor));
+    fputc('\t', fp);
+    deepbom_trace_hex(fp, ggml_type_name(tensor->type));
+    fputc('\t', fp);
+    deepbom_trace_hex(fp, tensor->name);
+    fprintf(fp, "\t%zu\t%lld,%lld,%lld,%lld\t%d\t",
+        ggml_nbytes(tensor),
+        (long long) tensor->ne[0],
+        (long long) tensor->ne[1],
+        (long long) tensor->ne[2],
+        (long long) tensor->ne[3],
+        tensor->flags);
+    for (int i = 0; i < GGML_MAX_SRC; ++i) {
+        if (i > 0) {
+            fputc(';', fp);
+        }
+        deepbom_trace_tensor_ref(fp, graph, tensor->src[i]);
+    }
+    fputc('\t', fp);
+    deepbom_trace_tensor_ref(fp, graph, tensor->view_src);
+    fputc('\n', fp);
+}
+
+static void deepbom_trace_graph(ggml_backend_sched_t sched, const struct ggml_cgraph * original_graph) {
+    const char * path = getenv("DEEPBOM_GGML_TRACE");
+    if (path == NULL || path[0] == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(deepbom_trace_mutex);
+    FILE * fp = ggml_fopen(path, "ab");
+    if (fp == NULL) {
+        GGML_LOG_ERROR("DEEPBOM_GGML_TRACE: cannot open trace destination\n");
+        return;
+    }
+    const uint64_t sequence = deepbom_trace_sequence.fetch_add(1, std::memory_order_relaxed) + 1;
+    sched->deepbom_trace_sequence = sequence;
+    const struct ggml_cgraph * scheduled_graph = &sched->graph;
+    fprintf(fp, "DEEPBOM_GGML_TRACE_V1\tgraph\t%llu\t%llu\t%d\t%d\t%d\t%d\t%d\n",
+        (unsigned long long) sequence,
+        (unsigned long long) original_graph->uid,
+        original_graph->n_nodes,
+        original_graph->n_leafs,
+        scheduled_graph->n_nodes,
+        scheduled_graph->n_leafs,
+        sched->n_splits);
+    for (int i = 0; i < sched->n_backends; ++i) {
+        fprintf(fp, "DEEPBOM_GGML_TRACE_V1\tbackend\t%llu\t%d\t", (unsigned long long) sequence, i);
+        deepbom_trace_hex(fp, ggml_backend_name(sched->backends[i]));
+        fputc('\t', fp);
+        ggml_backend_dev_t device = ggml_backend_get_device(sched->backends[i]);
+        deepbom_trace_hex(fp, device ? ggml_backend_dev_name(device) : "");
+        fputc('\n', fp);
+    }
+    for (int i = 0; i < sched->n_splits; ++i) {
+        const struct ggml_backend_sched_split * split = &sched->splits[i];
+        fprintf(fp, "DEEPBOM_GGML_TRACE_V1\tsplit\t%llu\t%d\t%d\t%d\t%d\t",
+            (unsigned long long) sequence, i, split->i_start, split->i_end, split->n_inputs);
+        deepbom_trace_hex(fp, ggml_backend_name(sched->backends[split->backend_id]));
+        fputc('\t', fp);
+        for (int j = 0; j < split->n_inputs; ++j) {
+            if (j > 0) {
+                fputc(';', fp);
+            }
+            deepbom_trace_tensor_ref(fp, original_graph, split->inputs[j]);
+        }
+        fputc('\n', fp);
+    }
+    for (int i = 0; i < original_graph->n_nodes; ++i) {
+        deepbom_trace_tensor(sched, fp, "original_node", sequence, i, deepbom_trace_split_id(sched, i),
+            tensor_backend_id(original_graph->nodes[i]), original_graph, original_graph->nodes[i]);
+    }
+    for (int i = 0; i < original_graph->n_leafs; ++i) {
+        deepbom_trace_tensor(sched, fp, "original_leaf", sequence, i, -1,
+            tensor_backend_id(original_graph->leafs[i]), original_graph, original_graph->leafs[i]);
+    }
+    for (int i = 0; i < scheduled_graph->n_nodes; ++i) {
+        deepbom_trace_tensor(sched, fp, "scheduled_node", sequence, i, -1,
+            sched->node_backend_ids[i], scheduled_graph, scheduled_graph->nodes[i]);
+    }
+    for (int i = 0; i < scheduled_graph->n_leafs; ++i) {
+        deepbom_trace_tensor(sched, fp, "scheduled_leaf", sequence, i, -1,
+            sched->leaf_backend_ids[i], scheduled_graph, scheduled_graph->leafs[i]);
+    }
+    fprintf(fp, "DEEPBOM_GGML_TRACE_V1\tgraph_end\t%llu\n", (unsigned long long) sequence);
+    fclose(fp);
+}
+
+static void deepbom_trace_dispatch(ggml_backend_sched_t sched, enum ggml_status status) {
+    const char * path = getenv("DEEPBOM_GGML_TRACE");
+    if (path == NULL || path[0] == 0 || sched->deepbom_trace_sequence == 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> lock(deepbom_trace_mutex);
+    FILE * fp = ggml_fopen(path, "ab");
+    if (fp == NULL) {
+        return;
+    }
+    fprintf(fp, "DEEPBOM_GGML_TRACE_V1\tdispatch\t%llu\t%d\n",
+        (unsigned long long) sched->deepbom_trace_sequence, (int) status);
+    fclose(fp);
+}
