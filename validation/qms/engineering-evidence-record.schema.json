{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepbom.org/schemas/engineering-evidence-record.v1.schema.json",
  "title": "DeepBOM engineering evidence review record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact", "evidence", "review", "limitations"],
  "properties": {
    "schema": { "const": "deepbom.engineering_evidence_review_record.v1" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "sha256", "location"],
      "properties": {
        "schema": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "location": { "type": "string", "minLength": 1 }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer", "reviewed_at", "disposition"],
      "properties": {
        "reviewer": { "type": "string", "minLength": 1 },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "disposition": { "enum": ["accepted_for_engineering_use", "rejected", "follow_up_required"] },
        "notes": { "type": "string" }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
