  "orchestration_contracts": {
    "web/app.js": {
      "required_fragments": [
        "function currentAnalysisView()",
        "const artifactView = currentArtifactIrContext?.primary_view || analysis;",
        "explorerDecisionController.render(artifactView",
        "renderGraphExplorer(artifactView)"
      ],
      "forbidden_patterns": [
        "\\bcurrent\\s*\\.\\s*(?:ops|tensors)\\b",
        "\\.render\\(analysis(?:[,)]|\\s)"
      ]
    },
    "bin/deepbom.mjs": {
