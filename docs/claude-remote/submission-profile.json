{
  "schema": "deepbom.claude_remote_submission.v1",
  "display_name": "DEEPBOM Artifact Evidence",
  "delivery": "remote_mcp_app",
  "version": "1.0.2",
  "endpoint": "https://deepbom.org/mcp/claude",
  "documentation_url": "https://deepbom.org/claude/",
  "privacy_url": "https://deepbom.org/privacy",
  "terms_url": "https://deepbom.org/terms",
  "support_url": "https://deepbom.org/support",
  "authentication": "none",
  "automatic_attachment_access": false,
  "model_byte_transfer": "The user selects one file in the MCP App; selected model bytes are analyzed in the browser sandbox and are not sent to the DEEPBOM service.",
  "conversation_data": "A bounded static-analysis result is returned to the Claude conversation and can contain artifact and model metadata plus a row-bounded format-neutral Model IR summary. It does not assert framework trainability or runtime order.",
  "host_validation_status": "not_yet_observed_on_claude_hosts",
  "listing_status": "not_submitted_or_approved_by_this_file",
  "agent_contract": {
    "id": "deepbom.agent_contract.v1",
    "version": "1.0.2",
    "compatibility": "backward_compatible_within_v1"
  },
  "evidence_contract": {
    "id": "deepbom.artifact_evidence_envelope.v1",
    "version": "1.0.0",
    "compatibility": "additive_fields_only_within_v1",
    "required_top_level_fields": [
      "schema",
      "generated_at",
      "identity",
      "artifact_set",
      "conversion_receipt",
      "cpu_cost_target_binding",
      "accelerator_profile_binding",
      "accelerator_bindings",
      "policy_identity",
      "capabilities",
      "interfaces",
      "graph",
      "external_files",
      "metadata",
      "findings",
      "format_extensions",
      "provenance",
      "evidence_boundary",
      "envelope_sha256"
    ],
    "conditional_top_level_fields": [
      "llm_token_budget_scenario",
      "structured_details"
    ],
    "semantic_boundaries": [
      "artifact_defects_cautions_and_evidence_gaps_remain_distinct",
      "static_predictions_are_not_runtime_observations",
      "unknown_and_not_assessable_are_not_coerced_to_absence_or_zero"
    ]
  },
  "engine_version_at_validation": "1.103.1"
}
