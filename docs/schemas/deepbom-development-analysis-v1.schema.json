{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepbom.org/schemas/deepbom-development-analysis-v1.schema.json",
  "title": "DEEPBOM development analysis supporting contracts",
  "description": "Supporting projections and explicit adapters. Not new Evidence IR family members; runtime semantic validation remains required.",
  "oneOf": [
    {
      "$ref": "#/$defs/facts"
    },
    {
      "$ref": "#/$defs/query"
    },
    {
      "$ref": "#/$defs/inspection"
    },
    {
      "$ref": "#/$defs/metric_configuration"
    },
    {
      "$ref": "#/$defs/builtin_metric_configuration"
    },
    {
      "$ref": "#/$defs/correspondence_request"
    },
    {
      "$ref": "#/$defs/correspondence"
    },
    {
      "$ref": "#/$defs/comparison"
    }
  ],
  "$defs": {
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "artifact_file",
            "artifact_set",
            "native_state",
            "snapshot",
            "evidence_document"
          ]
        },
        "schema": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "digest_scope": {
          "enum": [
            "file_bytes",
            "canonical_document"
          ]
        },
        "subject_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schema",
        "sha256",
        "digest_scope",
        "subject_ref"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "pointer": {
          "type": "string",
          "pattern": "^/"
        }
      },
      "required": [
        "reference",
        "pointer"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "value_decimal": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^-?(0|[1-9][0-9]*)$"
            },
            {
              "type": "null"
            }
          ]
        },
        "unit": {
          "enum": [
            "element",
            "byte",
            "MAC"
          ]
        },
        "status": {
          "enum": [
            "assessed",
            "assessed_subtotal",
            "not_assessed",
            "not_applicable"
          ]
        },
        "scope": {
          "type": "string"
        },
        "conditions": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "method": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "native_optimization_report_projection"
            },
            "version": {
              "const": "1.0.0"
            }
          },
          "required": [
            "name",
            "version"
          ]
        },
        "basis": {
          "const": "static_derived"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "value_decimal",
        "unit",
        "status",
        "scope",
        "conditions",
        "source",
        "method",
        "basis",
        "reason"
      ]
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.analysis_facts.v1"
        },
        "source": {
          "$ref": "#/$defs/reference"
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        },
        "validation": {
          "type": "object"
        },
        "boundary": {
          "type": "string"
        }
      },
      "required": [
        "schema",
        "source",
        "rows",
        "validation",
        "boundary"
      ]
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.optimization_report_query.v2"
        },
        "report_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "before_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "after_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "section": {
          "enum": [
            "summary",
            "facts",
            "validation",
            "invocations",
            "changes",
            "structure",
            "subject"
          ]
        },
        "boundary": {
          "type": "string"
        },
        "selection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "search": {
              "type": "string"
            },
            "subject": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sort": {
              "enum": [
                "source",
                "macs_desc"
              ]
            }
          },
          "required": [
            "search",
            "subject",
            "sort"
          ]
        },
        "export_scope": {
          "const": "returned_rows_with_source_references"
        },
        "total": {
          "type": "integer",
          "minimum": 0
        },
        "matched": {
          "type": "integer",
          "minimum": 0
        },
        "returned": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_bytes": {
              "type": "integer",
              "minimum": 2048,
              "maximum": 1048576
            },
            "termination": {
              "enum": [
                "page_limit",
                "byte_budget",
                "exhausted"
              ]
            }
          },
          "required": [
            "max_bytes",
            "termination"
          ]
        }
      },
      "required": [
        "schema",
        "report_sha256",
        "before_sha256",
        "after_sha256",
        "section",
        "boundary",
        "selection",
        "export_scope",
        "total",
        "matched",
        "returned",
        "offset",
        "next_offset",
        "rows",
        "budget"
      ]
    },
    "inspection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.native_inspection.v1"
        },
        "cost_method": {
          "const": "1.1.0"
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "snapshot": {
              "$ref": "https://deepbom.org/schemas/deepbom-native-evidence-v1.schema.json#/$defs/snapshot"
            },
            "model_ir": {
              "$ref": "https://deepbom.org/schemas/deepbom-native-evidence-v1.schema.json#/$defs/model"
            },
            "weight_ir": {
              "$ref": "https://deepbom.org/schemas/deepbom-native-evidence-v1.schema.json#/$defs/weight"
            },
            "activation_ir": {
              "anyOf": [
                {
                  "$ref": "https://deepbom.org/schemas/deepbom-native-evidence-v1.schema.json#/$defs/activation"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "snapshot",
            "model_ir",
            "weight_ir",
            "activation_ir"
          ]
        },
        "structure": {
          "$ref": "https://deepbom.org/schemas/deepbom-optimization-report-v1.schema.json#/$defs/structure"
        },
        "execution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "completed"
            },
            "shape_probe": {
              "enum": [
                "observed",
                "not_requested"
              ]
            }
          },
          "required": [
            "status",
            "shape_probe"
          ]
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "numerical_equivalence": {
              "const": "not_requested"
            },
            "task_quality": {
              "const": "not_requested"
            },
            "runtime_latency": {
              "const": "not_measured"
            }
          },
          "required": [
            "numerical_equivalence",
            "task_quality",
            "runtime_latency"
          ]
        }
      },
      "required": [
        "schema",
        "cost_method",
        "evidence",
        "structure",
        "execution",
        "validation"
      ]
    },
    "metric_configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.metric_configuration.v1"
        },
        "adapter_method": {
          "const": "1.0.0"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "torchmetrics"
            },
            "version": {
              "const": "1.9.0"
            },
            "torch_version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version",
            "torch_version"
          ]
        },
        "metric": {
          "enum": [
            "ssim",
            "generalized_dice"
          ]
        },
        "options": {
          "type": "object"
        },
        "aggregation": {
          "const": "equal_weight_sample_mean"
        },
        "analysis_unit": {
          "const": "sample"
        },
        "missing_policy": {
          "enum": [
            "reject",
            "omit_sample"
          ]
        },
        "mask_policy": {
          "const": "none"
        },
        "device": {
          "const": "cpu"
        },
        "prediction_dtype": {
          "type": "string"
        },
        "target_dtype": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "adapter_method",
        "producer",
        "metric",
        "options",
        "aggregation",
        "analysis_unit",
        "missing_policy",
        "mask_policy",
        "device",
        "prediction_dtype",
        "target_dtype",
        "shape",
        "configuration_sha256"
      ]
    },
    "builtin_metric_configuration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.metric_configuration.v2"
        },
        "adapter_method": {
          "const": "2.0.0"
        },
        "producer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "const": "deepbom-wasm"
            },
            "version": {
              "const": "1"
            },
            "abi": {
              "const": "deepbom.numerical_abi.v1:exact_binary64_v1"
            },
            "wasm_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "method": {
              "enum": [
                "separable_reflect_binary64_v1",
                "per_sample_weighted_counts_binary64_v1"
              ]
            }
          },
          "required": [
            "name",
            "version",
            "abi",
            "wasm_sha256",
            "method"
          ]
        },
        "metric": {
          "enum": [
            "ssim",
            "generalized_dice"
          ]
        },
        "options": {
          "type": "object"
        },
        "aggregation": {
          "const": "equal_weight_sample_mean"
        },
        "analysis_unit": {
          "const": "sample"
        },
        "missing_policy": {
          "enum": [
            "reject",
            "omit_sample"
          ]
        },
        "mask_policy": {
          "const": "none"
        },
        "device": {
          "const": "cpu"
        },
        "prediction_dtype": {
          "type": "string"
        },
        "target_dtype": {
          "type": "string"
        },
        "shape": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "configuration_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "adapter_method",
        "producer",
        "metric",
        "options",
        "aggregation",
        "analysis_unit",
        "missing_policy",
        "mask_policy",
        "device",
        "prediction_dtype",
        "target_dtype",
        "shape",
        "configuration_sha256"
      ]
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "source_subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "target_subjects": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "declared",
            "observed_exporter_metadata",
            "ambiguous"
          ]
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/reference"
          }
        }
      },
      "required": [
        "id",
        "source_subjects",
        "target_subjects",
        "status",
        "basis",
        "evidence"
      ]
    },
    "correspondence_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.correspondence_request.v1"
        },
        "source": {
          "$ref": "#/$defs/reference"
        },
        "target": {
          "$ref": "#/$defs/reference"
        },
        "bindings": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "documents": {
          "type": "array",
          "maxItems": 512,
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "schema",
        "source",
        "target",
        "bindings",
        "documents"
      ]
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.transformation_correspondence.v1"
        },
        "method_version": {
          "const": "1.0.0"
        },
        "request": {
          "$ref": "#/$defs/correspondence_request"
        },
        "source_check": {
          "type": "object"
        },
        "target_check": {
          "type": "object"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_subjects": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "target_subjects": {
                "type": "array",
                "minItems": 1,
                "maxItems": 10000,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "declared",
                  "observed_exporter_metadata",
                  "ambiguous"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "evidence": {
                "type": "array",
                "maxItems": 64,
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "source_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "target_refs": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/reference"
                }
              },
              "evidence_checks": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "interpretation": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "source_subjects",
              "target_subjects",
              "status",
              "basis",
              "evidence",
              "source_refs",
              "target_refs",
              "evidence_checks",
              "interpretation"
            ]
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "source",
            "target"
          ]
        },
        "coverage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source_total": {
              "type": "integer",
              "minimum": 0
            },
            "target_total": {
              "type": "integer",
              "minimum": 0
            },
            "source_referenced": {
              "type": "integer",
              "minimum": 0
            },
            "target_referenced": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "source_total",
            "target_total",
            "source_referenced",
            "target_referenced"
          ]
        },
        "boundary": {
          "type": "string"
        },
        "correspondence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "method_version",
        "request",
        "source_check",
        "target_check",
        "rows",
        "unmapped",
        "coverage",
        "boundary",
        "correspondence_sha256"
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "deepbom.mapped_model_comparison.v1"
        },
        "method_version": {
          "const": "1.0.0"
        },
        "correspondence_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source": {
          "$ref": "#/$defs/reference"
        },
        "target": {
          "$ref": "#/$defs/reference"
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "declared",
                  "observed_exporter_metadata",
                  "ambiguous"
                ]
              },
              "source": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "target": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "comparison_status": {
                "enum": [
                  "not_assessed_ambiguous",
                  "aligned_records_only"
                ]
              }
            },
            "required": [
              "id",
              "status",
              "source",
              "target",
              "comparison_status"
            ]
          }
        },
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "source": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "target": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "source",
            "target"
          ]
        },
        "boundary": {
          "type": "string"
        },
        "comparison_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema",
        "method_version",
        "correspondence_sha256",
        "source",
        "target",
        "rows",
        "unmapped",
        "boundary",
        "comparison_sha256"
      ]
    }
  }
}
