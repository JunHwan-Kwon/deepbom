{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepbom.org/schemas/deepbom-artifact-ir-v2.schema.json",
  "title": "DEEPBOM Artifact Evidence IR v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "method_version",
    "hash_contract",
    "artifact",
    "evidence_layers",
    "graph",
    "storage_topology",
    "architecture_projection",
    "quantization_contracts",
    "overlays",
    "completeness",
    "interpretation_boundary",
    "artifact_ir_sha256"
  ],
  "properties": {
    "schema": { "const": "deepbom.artifact_ir.v2" },
    "method_version": { "const": "2.1.0" },
    "hash_contract": {
      "type": "object",
      "required": ["algorithm", "canonicalization", "source_encoding", "excluded_pointers"],
      "properties": {
        "algorithm": { "const": "SHA-256" },
        "canonicalization": { "const": "RFC8785-JCS" },
        "source_encoding": { "const": "UTF-8" },
        "excluded_pointers": {
          "type": "array",
          "prefixItems": [{ "const": "/artifact_ir_sha256" }],
          "minItems": 1,
          "maxItems": 1
        }
      },
      "additionalProperties": false
    },
    "artifact": { "$ref": "#/$defs/artifact" },
    "evidence_layers": { "$ref": "#/$defs/evidenceLayers" },
    "graph": { "$ref": "#/$defs/graph" },
    "storage_topology": { "$ref": "#/$defs/storage" },
    "architecture_projection": { "$ref": "#/$defs/architecture" },
    "quantization_contracts": { "$ref": "#/$defs/quantization" },
    "overlays": { "$ref": "#/$defs/overlays" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "interpretation_boundary": { "type": "string", "minLength": 1 },
    "artifact_ir_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "exactInteger": {
      "type": "object",
      "required": ["decimal", "number"],
      "properties": {
        "decimal": { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" },
        "number": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["filename", "format", "sha256", "byte_length", "artifact_set_sha256"],
      "properties": {
        "filename": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byte_length": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "artifact_set_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "evidenceLayers": {
      "type": "object",
      "required": ["native_evidence", "canonical_ir", "static_projection", "runtime_evidence"],
      "properties": {
        "native_evidence": { "const": "artifact_serialized_or_hash_bound_sidecar_facts" },
        "canonical_ir": { "const": "format_neutral_identity_and_relationship_projection" },
        "static_projection": { "const": "separate_overlay_not_graph_fact" },
        "runtime_evidence": { "enum": ["not_imported", "imported_identity_bound_overlay"] }
      },
      "additionalProperties": false
    },
    "graph": {
      "type": "object",
      "required": ["status", "executable_graph_status", "scopes", "scope_relationships", "operators", "values", "inputs", "outputs", "totals", "completeness", "interpretation_boundary"],
      "properties": {
        "status": { "enum": ["serialized", "not_serialized"] },
        "executable_graph_status": { "type": "string" },
        "primary_scope_ref": { "type": ["string", "null"] },
        "scopes": { "type": "array", "items": { "$ref": "#/$defs/scope" } },
        "scope_relationships": { "type": "array", "items": { "$ref": "#/$defs/scopeRelationship" } },
        "operators": { "type": "array", "items": { "$ref": "#/$defs/operator" } },
        "values": { "type": "array", "items": { "$ref": "#/$defs/value" } },
        "inputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "outputs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "totals": { "$ref": "#/$defs/graphTotals" },
        "completeness": { "type": "string" },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "allOf": [{
        "if": { "properties": { "status": { "const": "not_serialized" } }, "required": ["status"] },
        "then": {
          "properties": {
            "scopes": { "type": "array", "maxItems": 0 },
            "scope_relationships": { "type": "array", "maxItems": 0 },
            "operators": { "type": "array", "maxItems": 0 },
            "values": { "type": "array", "maxItems": 0 },
            "inputs": { "type": "array", "maxItems": 0 },
            "outputs": { "type": "array", "maxItems": 0 }
          }
        }
      }],
      "additionalProperties": false
    },
    "identified": {
      "type": "object",
      "required": ["id"],
      "properties": { "id": { "type": "string", "minLength": 1 } }
    },
    "scope": {
      "type": "object",
      "required": ["id", "kind", "native_index", "name", "materialization_status", "parent_scope_ref", "invocation_semantics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "native_index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string", "minLength": 1 },
        "materialization_status": { "enum": ["materialized", "inventory_only"] },
        "parent_scope_ref": { "type": ["string", "null"] },
        "invocation_semantics": { "type": "string", "minLength": 1 },
        "declared_operator_count": { "type": ["integer", "null"], "minimum": 0 },
        "declared_value_count": { "type": ["integer", "null"], "minimum": 0 }
      },
      "additionalProperties": false
    },
    "scopeRelationship": {
      "type": "object",
      "required": ["id", "relation", "source_scope_ref", "source_operator_ref", "target_scope_ref", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "relation": { "type": "string", "minLength": 1 },
        "source_scope_ref": { "type": "string", "minLength": 1 },
        "source_operator_ref": { "type": ["string", "null"] },
        "target_scope_ref": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "operator": {
      "type": "object",
      "required": ["id", "legacy_graph_node_id", "scope_ref", "native_index", "op_type", "name", "domain", "version", "inputs", "outputs", "metrics", "quantization_summary", "topology", "native_source", "completeness"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope_ref": { "type": "string", "minLength": 1 },
        "native_index": { "type": "integer", "minimum": 0 },
        "op_type": { "type": "string", "minLength": 1 },
        "legacy_graph_node_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "domain": { "type": "string", "minLength": 1 },
        "version": { "type": ["integer", "null"] },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "outputs": { "type": "array", "items": { "$ref": "#/$defs/port" } },
        "metrics": { "$ref": "#/$defs/operatorMetrics" },
        "quantization_summary": { "$ref": "#/$defs/quantizationSummary" },
        "topology": { "$ref": "#/$defs/topology" },
        "native_source": { "$ref": "#/$defs/nativeSource" },
        "completeness": { "type": "string" }
      },
      "additionalProperties": false
    },
    "operatorMetrics": {
      "type": "object",
      "required": ["macs", "mac_assessment_status", "logical_io_bytes"],
      "properties": {
        "macs": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "mac_assessment_status": { "type": "string", "minLength": 1 },
        "logical_io_bytes": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "quantizationSummary": {
      "type": "object",
      "required": ["state", "risk"],
      "properties": { "state": { "type": "string", "minLength": 1 }, "risk": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "topology": {
      "type": "object",
      "required": ["depth", "role", "stage"],
      "properties": {
        "depth": { "type": ["integer", "null"], "minimum": 0 },
        "role": { "type": ["string", "null"] },
        "stage": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "port": {
      "type": "object",
      "required": ["port", "value_ref"],
      "properties": {
        "port": { "type": "integer", "minimum": 0 },
        "value_ref": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "value": {
      "type": "object",
      "required": ["id", "scope_ref", "native_index", "name", "value_kind", "dtype", "shape", "shape_signature", "shape_contract_status", "producer", "consumers", "roles", "storage_refs", "logical_byte_length", "native_source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "scope_ref": { "type": "string", "minLength": 1 },
        "native_index": { "type": "integer", "minimum": 0 },
        "name": { "type": "string" },
        "dtype": { "type": "string" },
        "value_kind": { "type": "string", "minLength": 1 },
        "shape": { "$ref": "#/$defs/shape" },
        "shape_signature": { "anyOf": [{ "$ref": "#/$defs/shape" }, { "type": "null" }] },
        "shape_contract_status": { "type": "string", "minLength": 1 },
        "producer": { "anyOf": [{ "$ref": "#/$defs/operatorPortReference" }, { "type": "null" }] },
        "consumers": { "type": "array", "items": { "$ref": "#/$defs/operatorPortReference" } },
        "roles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "storage_refs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "logical_byte_length": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "native_source": { "$ref": "#/$defs/nativeSource" }
      },
      "additionalProperties": false
    },
    "shape": { "type": "array", "items": { "anyOf": [{ "type": "integer" }, { "type": "string" }] } },
    "operatorPortReference": {
      "type": "object",
      "required": ["operator_ref", "port"],
      "properties": { "operator_ref": { "type": "string", "minLength": 1 }, "port": { "type": "integer", "minimum": 0 } },
      "additionalProperties": false
    },
    "nativeSource": {
      "type": "object",
      "required": ["format", "path"],
      "properties": {
        "format": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "byte_range": { "type": ["object", "null"] },
        "payload_offset_basis": { "type": "string" }
      },
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "required": ["status", "objects", "totals", "interpretation_boundary"],
      "properties": {
        "status": { "type": "string" },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/storageObject" } },
        "totals": { "$ref": "#/$defs/storageTotals" },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "storageObject": {
      "type": "object",
      "required": ["id", "native_index", "name", "dtype", "shape", "serialized_byte_length", "byte_range", "payload_sha256", "encoding", "native_source"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "native_index": { "type": "integer", "minimum": 0 },
        "source_parameter_index": { "type": "integer", "minimum": 0 },
        "scope_ref": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "dtype": { "type": "string", "minLength": 1 },
        "shape": { "$ref": "#/$defs/shape" },
        "serialized_byte_length": { "$ref": "#/$defs/exactInteger" },
        "byte_range": { "$ref": "#/$defs/byteRange" },
        "payload_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "encoding": { "$ref": "#/$defs/storageEncoding" },
        "native_source": { "$ref": "#/$defs/nativeSource" }
      },
      "additionalProperties": false
    },
    "byteRange": {
      "type": "object",
      "required": ["status", "offset_basis", "start", "end_exclusive"],
      "properties": {
        "status": { "enum": ["exact", "length_only", "not_assessed"] },
        "offset_basis": { "type": ["string", "null"] },
        "start": { "$ref": "#/$defs/nonnegativeIntegerOrStringOrNull" },
        "end_exclusive": { "$ref": "#/$defs/nonnegativeIntegerOrStringOrNull" }
      },
      "additionalProperties": false
    },
    "nonnegativeIntegerOrStringOrNull": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, { "type": "null" }] },
    "storageEncoding": {
      "type": "object",
      "required": ["family", "name", "block_elements", "block_bytes"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "block_elements": { "type": ["integer", "null"], "minimum": 1 },
        "block_bytes": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "storageTotals": {
      "type": "object",
      "required": ["object_count", "serialized_object_bytes_sum", "exact_range_count", "payload_digest_count"],
      "properties": {
        "object_count": { "type": "integer", "minimum": 0 },
        "serialized_object_bytes_sum": { "$ref": "#/$defs/exactInteger" },
        "exact_range_count": { "type": "integer", "minimum": 0 },
        "payload_digest_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": ["status", "executable_graph_status", "kind", "nodes", "relationships", "totals", "interpretation_boundary"],
      "properties": {
        "status": { "type": "string" },
        "executable_graph_status": { "type": "string" },
        "kind": { "type": ["string", "null"] },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/architectureNode" } },
        "relationships": { "type": "array", "maxItems": 0 },
        "totals": { "$ref": "#/$defs/architectureTotals" },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "architectureNode": {
      "type": "object",
      "required": ["id", "kind", "native_index", "label", "tensor_count", "serialized_bytes"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["decoder_layer_storage_group", "storage_namespace"] },
        "native_index": { "type": "integer", "minimum": 0 },
        "label": { "type": "string", "minLength": 1 },
        "tensor_count": { "type": ["integer", "null"], "minimum": 0 },
        "serialized_bytes": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "grouping_basis": { "type": ["object", "null"] },
        "storage_object_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    },
    "architectureTotals": {
      "type": "object",
      "required": ["node_count", "relationship_count"],
      "properties": {
        "node_count": { "type": "integer", "minimum": 0 },
        "relationship_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "quantization": {
      "type": "object",
      "required": ["status", "records", "totals", "interpretation_boundary"],
      "properties": {
        "status": { "type": "string" },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "subject_ref", "mapping", "parameterization", "storage", "parameters", "source", "completeness"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "subject_ref": { "type": "string", "minLength": 1 },
              "related_storage_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "mapping": { "$ref": "#/$defs/quantizationMapping" },
              "parameterization": { "$ref": "#/$defs/quantizationParameterization" },
              "storage": { "$ref": "#/$defs/quantizationStorage" },
              "parameters": { "$ref": "#/$defs/quantizationParameters" },
              "source": { "$ref": "#/$defs/quantizationSource" },
              "completeness": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "totals": {
          "type": "object",
          "required": ["record_count", "affine_record_count", "block_encoding_record_count", "complete_record_count", "partial_record_count"],
          "properties": {
            "record_count": { "type": "integer", "minimum": 0 },
            "affine_record_count": { "type": "integer", "minimum": 0 },
            "block_encoding_record_count": { "type": "integer", "minimum": 0 },
            "complete_record_count": { "type": "integer", "minimum": 0 },
            "partial_record_count": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "quantizationMapping": {
      "type": "object",
      "required": ["family", "scheme", "zero_point_constraint"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "minLength": 1 },
        "zero_point_constraint": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "quantizationParameterization": {
      "type": "object",
      "required": ["kind", "axes", "block_size"],
      "properties": {
        "kind": { "enum": ["per_tensor", "per_axis", "per_block", "per_group"] },
        "axes": { "type": "array", "items": { "type": "integer" }, "uniqueItems": true },
        "block_size": { "type": ["integer", "null"], "minimum": 1 },
        "group_count": { "type": ["integer", "null"], "minimum": 0 },
        "axis_status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "quantizationStorage": {
      "type": "object",
      "required": ["data_type", "code_min", "code_max", "block_bytes"],
      "properties": {
        "data_type": { "type": "string", "minLength": 1 },
        "code_min": { "type": ["integer", "null"] },
        "code_max": { "type": ["integer", "null"] },
        "code_domain_status": { "type": "string", "minLength": 1 },
        "block_bytes": { "type": ["integer", "null"], "minimum": 1 }
      },
      "additionalProperties": false
    },
    "quantizationParameters": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "scale": { "anyOf": [{ "$ref": "#/$defs/parameterDescriptor" }, { "type": "null" }] },
        "zero_point": { "anyOf": [{ "$ref": "#/$defs/parameterDescriptor" }, { "type": "null" }] },
        "additive_bias": { "anyOf": [{ "$ref": "#/$defs/parameterDescriptor" }, { "type": "null" }] },
        "lookup_table": { "anyOf": [{ "$ref": "#/$defs/parameterDescriptor" }, { "type": "null" }] }
      },
      "additionalProperties": false
    },
    "parameterDescriptor": {
      "type": "object",
      "required": ["count", "sha256", "inline_values", "inline_status"],
      "properties": {
        "count": { "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }, { "type": "null" }] },
        "sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "inline_values": { "type": ["array", "null"], "items": { "type": "number" } },
        "inline_status": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "quantizationSource": {
      "type": "object",
      "required": ["native_locator", "evidence_class"],
      "properties": {
        "native_locator": { "$ref": "#/$defs/nativeSource" },
        "evidence_class": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "overlays": {
      "type": "object",
      "required": ["static", "runtime"],
      "properties": {
        "static": { "type": "array", "items": { "$ref": "#/$defs/staticOverlay" } },
        "runtime": { "type": "array", "items": { "$ref": "#/$defs/runtimeOverlay" } }
      },
      "additionalProperties": false
    },
    "graphTotals": {
      "type": "object",
      "required": ["scope_count", "materialized_scope_count", "scope_relationship_count", "operator_count", "value_count", "relationship_count", "macs", "assessed_macs", "serialized_scope_assessed_macs", "mac_assessment"],
      "properties": {
        "scope_count": { "type": "integer", "minimum": 0 },
        "materialized_scope_count": { "type": "integer", "minimum": 0 },
        "scope_relationship_count": { "type": "integer", "minimum": 0 },
        "operator_count": { "type": "integer", "minimum": 0 },
        "value_count": { "type": "integer", "minimum": 0 },
        "relationship_count": { "type": "integer", "minimum": 0 },
        "macs": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "assessed_macs": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "serialized_scope_assessed_macs": { "anyOf": [{ "$ref": "#/$defs/exactInteger" }, { "type": "null" }] },
        "mac_assessment": { "type": ["object", "null"] }
      },
      "additionalProperties": false
    },
    "staticOverlay": {
      "type": "object",
      "required": ["id", "kind", "evidence_class", "summary", "rows", "interpretation_boundary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "static_placement" },
        "evidence_class": { "type": "string", "minLength": 1 },
        "summary": { "type": "object" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/overlayRow" } },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "runtimeOverlay": {
      "type": "object",
      "required": ["id", "kind", "evidence_class", "summary", "runtime_nodes", "rows", "interpretation_boundary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "runtime_assignment" },
        "evidence_class": { "const": "IMPORTED_IDENTITY_BOUND_RUNTIME_EVIDENCE" },
        "summary": { "$ref": "#/$defs/runtimeSummary" },
        "runtime_nodes": { "type": "array", "items": { "$ref": "#/$defs/runtimeNode" } },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/runtimeAssignmentRow" } },
        "interpretation_boundary": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "overlayRow": {
      "type": "object",
      "required": ["subject_ref", "state", "backend", "evidence_state", "evidence_class", "reason_codes", "unresolved_predicates"],
      "properties": {
        "subject_ref": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "backend": { "type": ["string", "null"] },
