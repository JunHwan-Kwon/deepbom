                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "block_size": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "scales": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "zero_points": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "encoding_minimum": {
              "type": "number"
            },
            "encoding_maximum": {
              "type": "number"
            },
            "observed_code_minimum": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "observed_code_maximum": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "range_utilization": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "lower_endpoint_count": {
              "type": "integer",
              "minimum": 0
            },
            "upper_endpoint_count": {
              "type": "integer",
              "minimum": 0
            },
            "endpoint_interpretation": {
              "type": "string"
            },
            "reconstruction_error": {
