        "name",
        "shape",
        "dtype",
        "status",
        "reason",
        "value_count",
        "representation",
        "axes",
        "statistics",
        "channels",
        "similarity",
        "spectrum",
        "sparsity",
        "quantization",
        "projection",
        "kernel"
