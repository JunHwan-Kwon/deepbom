{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepbom.org/schemas/deepbom-weight-analysis-v1.schema.json",
  "title": "DEEPBOM Weight IR derived analysis and comparison",
  "description": "Schema validation is followed by source/hash, reference, count conservation, budget and numeric invariant checks. Derived measurements are not execution evidence.",
  "oneOf": [
    {
      "$ref": "#/$defs/analysis"
    },
    {
      "$ref": "#/$defs/comparison"
    }
  ],
  "$defs": {
    "not_assessed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "not_assessed"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reason"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model_ir_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "artifact_set_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "model_ir_sha256",
        "artifact_sha256",
        "artifact_set_sha256"
      ]
    },
    "options": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_values": {
          "type": "integer",
          "minimum": 0
        },
        "max_tensor_values": {
          "type": "integer",
          "minimum": 0
        },
        "max_channels": {
          "type": "integer",
          "minimum": 0
        },
        "max_pairwise_channels": {
          "type": "integer",
          "minimum": 0
        },
        "max_svd_work": {
          "type": "integer",
          "minimum": 0
        },
        "tensor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "axes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "channel_axis": {
                "type": "integer",
                "minimum": 0
              },
              "sparsity_axis": {
                "type": "integer",
                "minimum": 0
              },
              "kernel_channel": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      },
      "required": [
        "max_values",
        "max_tensor_values",
        "max_channels",
        "max_pairwise_channels",
        "max_svd_work",
        "tensor_ids",
        "axes"
      ]
    },
    "axes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_axis": {
          "type": "integer",
          "minimum": 0
        },
        "channel_meaning": {
          "type": "string"
        },
        "basis": {
          "type": "string"
        },
        "storage_order": {
          "enum": [
            "first_axis_fastest",
            "last_axis_fastest"
          ]
        },
        "sparsity_axis": {
          "type": "integer",
          "minimum": 0
        },
        "sparsity_axis_basis": {
          "type": "string"
        }
      },
      "required": [
        "channel_axis",
        "channel_meaning",
        "basis",
        "storage_order",
        "sparsity_axis",
        "sparsity_axis_basis"
      ]
    },
    "projection": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "method": {
              "type": "string"
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "integer",
              "minimum": 0
            },
            "source_rows": {
              "type": "integer",
              "minimum": 0
            },
            "source_columns": {
              "type": "integer",
              "minimum": 0
            },
            "cells": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "zero_count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "mean": {
                    "type": "number"
                  },
                  "minimum": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "maximum": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "count",
                  "zero_count",
                  "mean",
                  "minimum",
                  "maximum"
                ]
              }
            }
          },
          "required": [
            "status",
            "method",
            "rows",
            "columns",
            "source_rows",
            "source_columns",
            "cells"
          ]
        }
      ]
    },
    "kernel": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "channel_index": {
              "type": "integer",
              "minimum": 0
            },
            "channel_count": {
              "type": "integer",
              "minimum": 0
            },
            "horizontal_native_axis": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "vertical_basis": {
              "type": "string"
            },
            "image": {
              "$ref": "#/$defs/projection"
            }
          },
          "required": [
            "status",
            "channel_index",
            "channel_count",
            "horizontal_native_axis",
            "vertical_basis",
            "image"
          ]
        }
      ]
    },
    "channels": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "count": {
              "type": "integer",
              "minimum": 0
            },
            "values_per_channel": {
              "type": "integer",
              "minimum": 0
            },
            "channels": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "statistics": {
                    "$ref": "https://deepbom.org/schemas/deepbom-numerical-ir-v1.schema.json#/$defs/statistics"
                  }
                },
                "required": [
                  "index",
                  "statistics"
                ]
              }
            }
          },
          "required": [
            "status",
            "count",
            "values_per_channel",
            "channels"
          ]
        }
      ]
    },
    "similarity": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "method": {
              "type": "string"
            },
            "size": {
              "type": "integer",
              "minimum": 0
            },
            "values": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "threshold": {
              "type": "number"
            },
            "pairs": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "a": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "b": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "cosine": {
                    "type": "number"
                  }
                },
                "required": [
                  "a",
                  "b",
                  "cosine"
                ]
              }
            },
            "clusters": {
              "type": "array",
              "items": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "cluster_method": {
              "type": "string"
            },
            "undefined_reason": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "method",
            "size",
            "values",
            "threshold",
            "pairs",
            "clusters",
            "cluster_method",
            "undefined_reason"
          ]
        }
      ]
    },
    "spectrum": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "method": {
              "type": "string"
            },
            "rows": {
              "type": "integer",
              "minimum": 0
            },
            "columns": {
              "type": "integer",
              "minimum": 0
            },
            "singular_values": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "normalized_singular_values": {
              "type": "array",
              "items": {
                "type": "number"
              }
            },
            "overflowed_singular_value_indices": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0
              }
            },
            "scale": {
              "type": "number"
            },
            "numerical_rank": {
              "type": "integer",
              "minimum": 0
            },
            "rank_tolerance": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "rank_tolerance_normalized": {
              "type": "number"
            },
            "condition_number": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "condition_status": {
              "type": "string"
            },
            "cumulative_energy": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "relative_frobenius_error_by_rank": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "sweeps": {
              "type": "integer",
              "minimum": 0
            },
            "orthogonality_residual": {
              "type": "number"
            },
            "energy_relative_residual": {
              "type": "number"
            },
            "work_count": {
              "type": "integer",
              "minimum": 0
            },
            "scope": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "method",
            "rows",
            "columns",
            "singular_values",
            "normalized_singular_values",
            "overflowed_singular_value_indices",
            "scale",
            "numerical_rank",
            "rank_tolerance",
            "rank_tolerance_normalized",
            "condition_number",
            "condition_status",
            "cumulative_energy",
            "relative_frobenius_error_by_rank",
            "sweeps",
            "orthogonality_residual",
            "energy_relative_residual",
            "work_count",
            "scope"
          ]
        }
      ]
    },
    "sparsity": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "assessed"
            },
            "zero_count": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "value_count": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "zero_fraction": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "block": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "basis": {
                  "type": "string"
                },
                "size": {
                  "type": "integer",
                  "minimum": 0
                },
                "complete_blocks": {
                  "type": "integer",
                  "minimum": 0
                },
                "all_zero_blocks": {
                  "type": "integer",
                  "minimum": 0
                },
                "trailing_values": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "basis",
                "size",
                "complete_blocks",
                "all_zero_blocks",
                "trailing_values"
              ]
            },
            "structured_2_4": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "axis": {
                  "type": "integer",
                  "minimum": 0
                },
                "groups": {
                  "type": "integer",
                  "minimum": 0
                },
                "compliant_groups": {
                  "type": "integer",
                  "minimum": 0
                },
                "trailing_values": {
                  "type": "integer",
                  "minimum": 0
                },
                "pattern_satisfied": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "scope": {
                  "type": "string"
                }
              },
              "required": [
                "axis",
                "groups",
                "compliant_groups",
                "trailing_values",
                "pattern_satisfied",
                "scope"
              ]
            }
          },
          "required": [
            "status",
            "zero_count",
            "value_count",
            "zero_fraction",
            "block",
            "structured_2_4"
          ]
        }
      ]
    },
    "quantization": {
      "oneOf": [
        {
          "$ref": "#/$defs/not_assessed"
        },
        {
          "type": "object",
