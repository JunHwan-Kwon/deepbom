              "type": "null"
            }
          ]
        },
        "channels": {
          "$ref": "#/$defs/channels"
        },
        "similarity": {
          "$ref": "#/$defs/similarity"
        },
        "spectrum": {
          "$ref": "#/$defs/spectrum"
        },
        "sparsity": {
